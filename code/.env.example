# Copy to .env and fill in. Never commit .env. Load with: uvicorn src.app:app --env-file .env

# Default is a local SQLite file. For PostgreSQL (needs the "postgres" extra):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/tickets
DATABASE_URL=sqlite:///./tickets.db

# DEVELOPMENT ONLY ticket signing key: EC P-256 private key, PEM on one line with \n separators.
# Set it so tickets stay verifiable across restarts and multiple processes. Empty = random key per process.
# Generate: see README ("Development signing key").
DEV_SIGNING_KEY=
